// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model User {
  id              String    @id @default(uuid())
  username        String
  email           String    @unique
  hashedPassword  String
  createdAt       DateTime  @default(now())
  

  monitors        Monitor[]

  @@index([id, email])
  @@map("users")
}



model Monitor {
  id            String    @id @default(uuid())
  url           String    
  name          String?
  isActive      Boolean       @default(true)
  interval      Int           @default(5) 
  lastCheckedAt DateTime      @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  checks        Check[]

@@map("monitors")
}


model Region {
  id        String   @id @default(uuid())
  name      String   // e.g., "US East", "Mumbai", "Europe"
  code      String   // e.g., "us-east-1", "ap-south-1"
  checks    Check[]
  
  @@map("regions")
}


model Check {
  id              String          @id @default(uuid())
  status          StatusChecking
  responseTime_ms Int   
  statusCode      Int?
  checkedAt       DateTime        @default(now())
  monitorId       String
  regionId        String?         // ✅ Naya add kiya (Optional rakha hai, taaki purana code na tute)
  
  monitor         Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  region          Region?         @relation(fields: [regionId], references: [id]) // ✅ Region link kiya
  
  @@map("checks")
}




enum StatusChecking {
  UP
  DOWN
  UNKNOWN


}